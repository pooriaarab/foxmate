{
  "name": "foxmate",
  "version": "0.1.22",
  "description": "Firefox AI browser agent with local Ollama and llama.cpp planning, action approvals, editable memory, Claude Code bridge and task schedules.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/foxmate.git"
  },
  "homepage": "https://github.com/pooriaarab/foxmate#readme",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-ext",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "test": "vitest run --passWithNoTests",
    "ci:local": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:ext && pnpm lint:ext && pnpm check:amo",
    "build:ext": "node scripts/build-ext.mjs",
    "lint:ext": "node scripts/lint-ext.mjs",
    "check:amo": "node scripts/amo-listing.mjs check",
    "e2e": "pnpm build:ext && node e2e/run.mjs",
    "bench": "pnpm build:ext && node cli/foxmate.mjs bench"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "foxbridge": "^0.1.2",
    "jsqr": "1.4.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "create-foxkit": "^0.1.5",
    "foxbench": "^0.1.7",
    "foxden": "npm:foxden-sandbox@^0.1.2",
    "foxgate": "^0.1.3",
    "foxlend": "^0.1.2",
    "foxlens": "^0.1.2",
    "foxlink": "npm:foxlink-oauth@^0.1.2",
    "foxloop": "^0.1.17",
    "foxmemory": "^0.1.2",
    "foxmind": "^0.1.5",
    "foxnotify": "^0.1.0",
    "foxpass": "^0.1.3",
    "foxpaw": "^0.1.15",
    "foxpay-agent": "^0.1.2",
    "foxrunner": "^0.1.2",
    "foxshield": "^0.1.6",
    "foxsync": "^0.1.2",
    "foxtrail": "^0.1.2",
    "foxvault": "^0.1.2",
    "foxvoice": "^0.1.0",
    "uqr": "0.1.3"
  },
  "bin": {
    "foxmate": "cli/foxmate.mjs"
  },
  "keywords": [
    "firefox",
    "ai-browser-agent",
    "browser-automation",
    "ollama",
    "llama-cpp",
    "saluki",
    "hugging-face",
    "claude-code",
    "gmail",
    "google-calendar",
    "ntfy",
    "local-ai",
    "typescript",
    "agent-memory",
    "x402"
  ]
}
