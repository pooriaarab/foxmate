{
  "manifest_version": 3,
  "name": "foxmate — a personal agent in your browser",
  "version": "0.1.2",
  "description": "An open-source personal agent that runs in your own Firefox.",
  "icons": { "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": {
    "gecko": {
      "id": "foxmate@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": ["websiteContent", "personalCommunications", "authenticationInfo"]
      }
    }
  },
  "permissions": ["storage", "unlimitedStorage", "scripting", "tabs", "webRequest", "webRequestBlocking", "alarms", "cookies", "contextualIdentities", "browsingData", "proxy", "privacy", "publicSuffix", "notifications", "identity"],
  "optional_permissions": ["nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "foxmate",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  },
  "sidebar_action": {
    "default_title": "foxmate",
    "default_panel": "sidebar.html",
    "default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" },
    "open_at_install": false
  },
  "sandbox": {
    "pages": ["den/den.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src blob:; connect-src 'none'"
  }
}
